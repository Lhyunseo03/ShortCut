<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC000000"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="알림"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/popupMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/popupButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="그만보기"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="20dp"/>

        <!-- btnIgnore 를 FrameLayout 으로 감싸서 카운트다운 TextView 를 오버레이로 띄울 수 있게 함 (variant 1) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnIgnore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계속보기"
                android:backgroundTint="#888888"
                android:textColor="#FFFFFF"/>

            <!-- variant 1 카운트다운 — 평소엔 GONE -->
            <TextView
                android:id="@+id/ignoreCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
