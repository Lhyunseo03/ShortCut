<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--INTERNET 권한 없으면 SocketManager.kt가 서버에 아예 연결을 못 해요. 소켓 통신 자체가 인터넷을 쓰는 거니까요.
    SYSTEM_ALERT_WINDOW 바로 아래에 한 줄 추가하면 돼요.-->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 접근성 권한 OFF 우회 차단용 GuardForegroundService — UsageStatsManager 로 포그라운드 앱 폴링 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AI 앱 바로 연결 기능 — Android 11+(targetSdk 30↑) 패키지 가시성 제한 때문에
         실행/설치여부를 확인할 AI 앱들을 명시해야 getLaunchIntentForPackage 가 동작함.
         마지막 VIEW intent 는 앱 미설치 시 웹(브라우저)으로 폴백하기 위한 가시성. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.anthropic.claude" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShortCut">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ShortCut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".services.ShortCutAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 접근성 OFF 시 타겟앱 진입을 막는 보조 가드 — UsageStatsManager 폴링 -->
        <service
            android:name=".services.GuardForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Block shorts/reels apps when accessibility permission is disabled" />
        </service>

    </application>

</manifest>

